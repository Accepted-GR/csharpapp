<Project>

    <!--
      Common build settings for every project in the repository.
      Keeping these here avoids the drift that comes from repeating the same
      four properties in every .csproj.
    -->
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <PropertyGroup>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!--
          Enabled once the Phase 1 refactor cleared the pre-existing CS8602,
          CA1001 and IDE0052 warnings. From here on a new warning fails the
          build rather than accumulating unnoticed.
        -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

</Project>
